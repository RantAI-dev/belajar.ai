# Copy to .env (which is never committed) and fill in what this project uses.

# Optional: a Lark base that mirrors BACKLOG.md. Leave these unset on a small or one-person
# project; nothing will ask for them.
# LARK_BASE_TOKEN=
# The row for this repository in the base's Products table, or in its Projects table. One of the two.
# LARK_PRODUCT=
# LARK_PROJECT=

# ---- belajar-server -------------------------------------------------------------------------
# Postgres. Locally: `scripts/dev-db.sh` starts a container and prints this URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres
# Where the server listens.
BELAJAR_ADDR=127.0.0.1:8080
# The built web app the server serves.
BELAJAR_WEB_DIR=web/dist
# Session cookie gets the Secure flag. false only for plain-http local development.
BELAJAR_COOKIE_SECURE=false
# The upstream learning API. Locally: the in-repo fake (`cargo run -p belajar-fake-upstream`).
BELAJAR_UPSTREAM_URL=http://127.0.0.1:8090
# One key per grade and assistant (ask, learn, practice): comma-separated `<grade>.<assistant>=<key>`.
# Real keys live only in the deployment's secret store, never in this file. The fake accepts any
# key that starts with "fake-".
BELAJAR_UPSTREAM_KEYS=7.ask=fake-7-ask,7.learn=fake-7-learn,7.practice=fake-7-practice
# Time to wait for the upstream's first byte, and between stream events.
BELAJAR_UPSTREAM_TIMEOUT_MS=60000
